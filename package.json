{
  "name": "dsh-stt-multi",
  "description": "Multi-provider speech-to-text for DeepSeek Harness: Whisper / GigaAM / OpenAI-compatible API behind the native mic button",
  "version": "0.6.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/providers/*.js",
    "dist/worker/*.js",
    "dist/download/*.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "sherpa-onnx-node": "~1.13.8"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-experimental-speech-to-text": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-experimental-speech-to-text": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
